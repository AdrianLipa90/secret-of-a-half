Μ(LEFT_OPERATOR) = Z_OVER_1_PLUS_Z
Μ(RIGHT_OPERATOR) = Z_PLUS_1
Μ(CONJUGACY_LEFT) = J_AFTER_LEFT_EQUALS_RIGHT_AFTER_J
Μ(CONJUGACY_RIGHT) = J_AFTER_RIGHT_EQUALS_LEFT_AFTER_J
Μ(EXPLICIT_HALF_CONSTANT_IN_OPERATOR) = FALSE
Μ(PRIMARY_TEST) = SEED_STREAM_WITH_PRIMARY_BRANCHES
