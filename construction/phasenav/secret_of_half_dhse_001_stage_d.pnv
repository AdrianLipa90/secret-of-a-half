# Secret of a Half — DHSE-001 Stage D
# Exact operator-geometry atlas for the four Stage B experimental families

Μ(PROGRAM) = DHSE_001_STAGE_D
Μ(VERSION) = 0.1
Μ(STATUS) = EXACT_OPERATOR_ATLAS_BRANCH_ONLY
Μ(DOMAIN) = POSITIVE_PROJECTIVE_ODDS_z>0
Μ(TARGET) = q=1_EQUIVALENT_TO_p=1/2
Μ(TARGET_BALL) = [9/11,11/9]
Μ(WORD_ORDER) = LEFT_TO_RIGHT
Μ(MAX_WORD_LENGTH) = 8
Μ(AFFINE_MECHANISM) = L_FIXES_q1_WITH_MULTIPLIER_2/3
Μ(AFFINE_ITERATE) = L^n(z)=1+(2/3)^n*(z-1)
Μ(MOBIUS_MECHANISM) = EVERY_WORD_ENDING_LR_FORCES_TARGET_BALL
Μ(MOBIUS_MINIMAL_WORD) = LR
Μ(MOBIUS_COMPOSITION) = R(L(z))=(5*z+6)/(5*z+7)
Μ(MOBIUS_IMAGE) = (6/7,1)
Μ(SCALE_TRANSLATE_MECHANISM) = MONOTONE_ESCAPE_TO_INFINITY
Μ(COLLATZ_MECHANISM) = RL_FIXES_q1_WITH_MULTIPLIER_3/4
Μ(COLLATZ_ITERATE) = (L_AFTER_R)^n(z)=1+(3/4)^n*(z-1)
Μ(SHARED_MECHANISM) = FALSE
Μ(CONCLUSION) = NO_OPERATOR_INDEPENDENT_HALF_SELECTION
Μ(NO_PROMOTION) = OPERATOR_LOCAL_MECHANISMS_ONLY
