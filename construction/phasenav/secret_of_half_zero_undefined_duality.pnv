# Secret of a Half — Zero–Undefined Reciprocal Duality v0.4
# Author: Adrian Lipa
# Status: exact labelled-state geometry plus exploratory interpretation.
#
# IMPORTANT: IEEE NaN is not treated as a number or an ordered endpoint.
# UNDEFINED_BOTTOM is an abstract informational label. NaN is only an
# implementation marker that may be mapped to that label before arithmetic.

─── SOH / OPERATOR VOCABULARY ───
SOU001: name=DEFINED_ZERO_VERTEX, operator=IDENTITY, type=NOUN, gen=0
SOU002: name=UNDEFINED_BOTTOM_VERTEX, operator=IDENTITY, type=NOUN, gen=0
SOU003: name=COMPLEMENT_SWAP, operator=ORBIT, type=CYCLE, gen=1
SOU004: name=PROJECTIVE_ODDS, operator=DIFFERENTIAL, type=VERB, gen=1
SOU005: name=RECIPROCAL_DUALITY, operator=ORBIT, type=CYCLE, gen=1
SOU006: name=SELF_DUAL_HALF, operator=AFFECT, type=EMOTION, gen=1
SOU007: name=FISHER_RAO_MIDPOINT, operator=DIFFERENTIAL, type=VERB, gen=2
SOU008: name=IEEE_NAN_GUARD, operator=IDENTITY, type=NOUN, gen=0

─── SOH / EXECUTION PROFILE ───
Μ(PROGRAM) = SECRET_OF_HALF_ZERO_UNDEFINED_DUALITY
Μ(VERSION) = 0.4.0
Μ(BASE_HEAD) = 5c4883d795ac0556a0d76aed88f50477a4cf1c1c
Μ(STATE_SPACE) = LABELLED_BINARY_SIMPLEX
Μ(LEFT_VERTEX) = DEFINED_ZERO
Μ(RIGHT_VERTEX) = UNDEFINED_BOTTOM
Μ(IMPLEMENTATION_MARKER) = IEEE_NAN_MAPS_TO_UNDEFINED_BEFORE_ARITHMETIC
Μ(PROJECTIVE_COORDINATE) = Z_ODDS
Μ(RECIPROCAL_MAP) = Z_ODDS_TO_1_OVER_Z_ODDS
Μ(STATUS) = EXACT_GEOMETRY_EXPLORATORY_ONTOLOGY_NOT_RH_PROOF

─── SOH / NATIVE MEANING EQUATIONS ───
Μ(STATE(P)) = (1-P)*DEFINED_ZERO + P*UNDEFINED_BOTTOM
Μ(DOMAIN_P) = CLOSED_INTERVAL_0_1
Μ(COMPLEMENT(P)) = 1-P
Μ(Z_ODDS(P)) = P/(1-P)
Μ(INVERSE_ODDS(Z)) = Z/(1+Z)
Μ(ENDPOINT_ZERO) = P=0 <=> Z_ODDS=0
Μ(ENDPOINT_UNDEFINED) = P=1 <=> Z_ODDS=INFINITY
Μ(RECIPROCAL(Z)) = 1/Z
Μ(ENDPOINT_SWAP) = RECIPROCAL(0)=INFINITY AND RECIPROCAL(INFINITY)=0
Μ(CONJUGACY) = Z_ODDS(COMPLEMENT(P)) = RECIPROCAL(Z_ODDS(P))
Μ(SELF_DUAL_ODDS) = Z_ODDS=1
Μ(SELF_DUAL_WEIGHT) = P=1/2
Μ(AMPLITUDE_STATE(P)) = (SQRT(1-P), SQRT(P))
Μ(SWAP_FIXED_STATE) = (1/SQRT(2), 1/SQRT(2))
Μ(FISHER_RAO_COORDINATE(P)) = 2*ARCSIN(SQRT(P))
Μ(FISHER_RAO_ENDPOINTS) = THETA(0)=0 AND THETA(1)=PI
Μ(FISHER_RAO_MIDPOINT) = THETA(1/2)=PI/2
Μ(BINARY_ENTROPY(P)) = -P*LOG(P)-(1-P)*LOG(1-P)
Μ(MAXIMUM_ENTROPY) = BINARY_ENTROPY(1/2)=LOG(2)

─── SOH / CLAIM BOUNDARY ───
Μ(EXACT_L015) = COMPLEMENT_IS_CONJUGATE_TO_RECIPROCAL_IN_ODDS_COORDINATE
Μ(EXACT_L016) = UNIQUE_POSITIVE_RECIPROCAL_FIXED_POINT_CORRESPONDS_TO_P_EQUALS_HALF
Μ(EXACT_L017) = P_EQUALS_HALF_IS_FISHER_RAO_GEODESIC_MIDPOINT
Μ(EXPLORATORY_H001) = UNDEFINED_AND_DEFINED_ZERO_ARE_INFORMATIONAL_ENDPOINT_LABELS
Μ(NAN_BOUNDARY) = IEEE_NAN_IS_UNORDERED_AND_NOT_USED_AS_NUMERIC_ENDPOINT
Μ(NO_PROMOTION) = LABELLED_STATE_DUALITY_ALONE_DOES_NOT_PROVE_RH
