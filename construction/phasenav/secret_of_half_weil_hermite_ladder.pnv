# Secret of a Half — native PhaseNav-Weil Hermite ladder v0.3
# Author: Adrian Lipa
# Base main: 5c4883d795ac0556a0d76aed88f50477a4cf1c1c
# Status: dense-core arithmetic audit; NOT a proof of RH.
#
# The authoritative objects are a translated-scaled Hermite channel ladder,
# its closed Fourier matrix kernel, and an arithmetic Weil principal-minor scan.
# Python parses and audits this source; Python is not the source of construction.

─── SOH / OPERATOR VOCABULARY ───
SOHHL001: name=HERMITE_CHANNEL_SEED, operator=IDENTITY, type=NOUN, gen=0
SOHHL002: name=SCHWARTZ_DENSE_LADDER, operator=ORBIT, type=CYCLE, gen=1
SOHHL003: name=GAUSSIAN_POLYNOMIAL_TRANSPORT, operator=DIFFERENTIAL, type=VERB, gen=1
SOHHL004: name=WEIL_PRINCIPAL_MATRIX, operator=AFFECT, type=EMOTION, gen=1
SOHHL005: name=CUTOFF_LADDER_AUDIT, operator=DIFFERENTIAL, type=VERB, gen=2
SOHHL006: name=FINITE_SECTION_NULL_MODE, operator=IDENTITY, type=NOUN, gen=0
SOHHL007: name=OPEN_UNIFORM_POSITIVITY, operator=ORBIT, type=CYCLE, gen=2

─── SOH / EXECUTION PROFILE ───
Μ(PROGRAM) = SECRET_OF_HALF_WEIL_HERMITE_LADDER
Μ(VERSION) = 0.3.0
Μ(BASE_HEAD) = 5c4883d795ac0556a0d76aed88f50477a4cf1c1c
Μ(MAX_BASIS_SIZE) = 6
Μ(TARGET_ORDINATE) = 14.134725141734695
Μ(GAUSSIAN_WIDTH) = 0.8
Μ(PRIME_CUTOFF) = 50000
Μ(AUDIT_PRIME_CUTOFF) = 100000
Μ(HERMITE_QUADRATURE_ORDER) = 96
Μ(MP_DPS) = 50
Μ(STABILITY_TOLERANCE) = 1e-10
Μ(PSD_TOLERANCE) = 2e-8
Μ(FOURIER_TOLERANCE) = 2e-10
Μ(SYNTHETIC_OFF_AXIS_DELTA) = 0.1
Μ(SYNTHETIC_NEGATIVITY_THRESHOLD) = -1e-3
Μ(FOURIER_NORMALIZATION) = EXP_MINUS_2PI_I_X_R
Μ(INVOLUTION) = CENTERED_SWAP_CONJUGATE
Μ(BASIS) = TRANSLATED_SCALED_PHYSICISTS_HERMITE_FUNCTIONS
Μ(OPERATOR) = GUINAND_WEIL_HERMITE_PRINCIPAL_LADDER
Μ(SPECTRAL_ZERO_INPUT) = NONE_FOR_ARITHMETIC_SUM
Μ(STATUS) = DENSE_CORE_AUDIT_NOT_PROOF

─── SOH / NATIVE MEANING EQUATIONS ───
Μ(CENTERED_Z) = S - 1/2
Μ(SPECTRAL_R) = CENTERED_Z / I
Μ(J_R) = CONJUGATE(SPECTRAL_R)
Μ(Y) = GAUSSIAN_WIDTH * (R - TARGET_ORDINATE)
Μ(NORM_N) = SQRT(GAUSSIAN_WIDTH/(SQRT(PI)*2^N*N!))
Μ(PSI_N(R)) = NORM_N * HERMITE_PHYSICISTS(N,Y) * EXP(-Y^2/2)
Μ(H_MN(R)) = CONJUGATE(PSI_M(CONJUGATE(R))) * PSI_N(R)
Μ(HERMITE_LINEARIZATION) = H_M(Y)*H_N(Y) == SUM[K=0..MIN(M,N)](2^K*K!*BINOM(M,K)*BINOM(N,K)*H_{M+N-2K}(Y))
Μ(HHAT_MN(X)) = INTEGRAL[R=-INFINITY..INFINITY](H_MN(R)*EXP(-2*PI*I*X*R) dR)
Μ(HHAT_CLOSED_MN(X)) = NORM_M*NORM_N/GAUSSIAN_WIDTH * SQRT(PI) * EXP(-2*PI*I*X*TARGET_ORDINATE) * EXP(-(2*PI*X/GAUSSIAN_WIDTH)^2/4) * SUM[K](2^K*K!*BINOM(M,K)*BINOM(N,K)*(-I*2*PI*X/GAUSSIAN_WIDTH)^(M+N-2K))
Μ(ORTHONORMALITY) = HHAT_MN(0) == KRONECKER_DELTA(M,N)
Μ(DENSE_CORE) = CLOSURE_SCHWARTZ(SPAN{PSI_N:N>=0}) == SCHWARTZ(R)
Μ(ARITHMETIC_WEIL_MN) = POLE_MN + CONDUCTOR_MN + ARCHIMEDEAN_MN + PRIME_MN
Μ(W_N) = HERMITIAN_MATRIX[ARITHMETIC_WEIL_MN, M,N IN {0..N-1}]
Μ(PRINCIPAL_LADDER) = {W_1,W_2,...,W_MAX_BASIS_SIZE}
Μ(CUTOFF_STABLE_N) = MAX_ENTRY_NORM(W_N(AUDIT_PRIME_CUTOFF)-W_N(PRIME_CUTOFF)) <= STABILITY_TOLERANCE
Μ(PSD_SAMPLE_N) = MIN_EIGENVALUE(W_N(AUDIT_PRIME_CUTOFF)) >= -PSD_TOLERANCE
Μ(DENSE_CORE_REDUCTION) = (FOR_ALL_N W_N>=0 AND WEIL_FORM_CONTINUOUS) => WEIL_FORM>=0_ON_SCHWARTZ
Μ(SYNTHETIC_QUARTET_R) = {+GAMMA0+I*DELTA,+GAMMA0-I*DELTA,-GAMMA0+I*DELTA,-GAMMA0-I*DELTA}
Μ(FALSIFICATION_WITNESS) = MIN_EIGENVALUE(SPECTRAL_MATRIX(SYNTHETIC_QUARTET_R)) < SYNTHETIC_NEGATIVITY_THRESHOLD

─── SOH / CLAIM BOUNDARY ───
Μ(EXACT_DENSITY_STATEMENT) = TRANSLATED_SCALED_HERMITE_FINITE_SPANS_ARE_DENSE_IN_SCHWARTZ
Μ(EXACT_TRANSFORM_STATEMENT) = HHAT_MN == HHAT_CLOSED_MN
