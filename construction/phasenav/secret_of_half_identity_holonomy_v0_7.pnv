─── SOH / CROSS-FACTORIZATION ───
Μ(COUNT_24_A) = 8 * 3
Μ(COUNT_24_B) = 12 * 2
Μ(COUNT_24_C) = 6 * 4
Μ(COUNT_CROSSCHECK) = COUNT_24_A == COUNT_24_B == COUNT_24_C == 24
Μ(COUNT_STATUS) = EXACT_ARITHMETIC_WITH_MODEL_SEMANTICS

─── SOH / INFORMATION-PHASE NORMALIZATION ───
Μ(INFORMATION_QUANTUM) = LN(2)
Μ(INFORMATION_PER_PROJECTIVE_TURN) = LN(2) / 12
Μ(INFORMATION_ANGULAR_DENSITY) = INFORMATION_PER_PROJECTIVE_TURN / CLOSURE_PERIOD
Μ(KAPPA_AT_RADIAN_CLOSURE) = LN(2) / (24*PI)
Μ(INFORMATION_CYCLE_STATUS) = MODEL_POSTULATE

─── SOH / TIR CROSSWALK ───
Μ(TIR_ARITHMETIC_SECTOR) = INFORMATION_ARITHMETIC -> ENERGY_AND_MATTER [MODEL]
Μ(TIR_PHASE_GEOMETRY_SECTOR) = PHASE_GEOMETRY -> TIME_AND_SPACE [MODEL]
Μ(TIR_TIME_FROM_TAU) = DEFERRED
Μ(TIR_W_IJ) = CROSS_REFERENCE_ONLY
Μ(PHASENAV_DEPENDENCY_PACKAGE) = ciel_geometry.phasenav.dependencies
Μ(VECTORIZATION) = GEOMETRIC_TANGENT_LOG_MAP -> VECTOR_COMPONENTS

─── SOH / FIREWALL ───
Μ(DEFAULT_CLOSURE) = EXACT + STANDARD
Μ(MODEL_CLOSURE) = EXACT + STANDARD + EXPLICIT_MODEL
Μ(OPEN_PROMOTION) = FORBIDDEN
Μ(RH_MUST_REMAIN_OPEN_WITHOUT_CANONICAL_ZERO_STATE) = TRUE
