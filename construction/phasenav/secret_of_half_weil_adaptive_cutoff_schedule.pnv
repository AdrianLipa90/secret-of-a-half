─── SOH / NATIVE MEANING EQUATIONS ───
Μ(MAX_DEGREE_N) = 2*N-2
Μ(LOG_Q_N) = MAX(LOG(BASE_CUTOFF), LOG_CUTOFF_SLOPE*N)
Μ(Q_N) = CEIL(EXP(LOG_Q_N))
Μ(ALPHA_D(U)) = U/(2*GAUSSIAN_WIDTH^2) - 1/2 - (D+1)/U
Μ(ELEMENTARY_I_D_BOUND) = U^(D+1)*EXP(-U^2/(4*W^2)+U/2)/(W^D*ALPHA_D(U))
Μ(HERMITE_TERM_COUNT_BOUND) = N
Μ(HERMITE_COEFFICIENT_BOUND) = 2^(3*N-3)*(N-1)!
Μ(FINITE_SECTION_LOG_ENVELOPE) = LOG(N^2*2^(3*N-3)*(N-1)!/PI) + LOG(ELEMENTARY_I_MAX)
Μ(ASYMPTOTIC_SCHEDULE) = FOR_ANY_C>0, LOG_Q_N=C*N IMPLIES LOG_ENVELOPE=-C^2*N^2/(4*W^2)+O(N*LOG(N))
Μ(ASYMPTOTIC_COLLAPSE) = FOR_ANY_C>0, EXP(LOG_ENVELOPE) -> 0 AS N -> INFINITY
