─── SOH / NATIVE MEANING EQUATIONS ───
Μ(HALF) = 1/2
Μ(Z) = S - HALF
Μ(DELTA) = RE(Z)
Μ(TIME_PHASE) = IM(Z)
Μ(THETA(U)) = SUM[n=1..INFINITY](EXP(-PI*n^2*EXP(U)))
Μ(BASE_GAIN_k) = Q_k * THETA(U_k) * EXP(U_k/4)
Μ(CHANNEL_PLUS_k) = BASE_GAIN_k * EXP(+Z*U_k/2)
Μ(CHANNEL_MINUS_k) = BASE_GAIN_k * EXP(-Z*U_k/2)
Μ(PHASE_PLUS_k) = +TIME_PHASE*U_k/2 MOD TAU
Μ(PHASE_MINUS_k) = -TIME_PHASE*U_k/2 MOD TAU
Μ(GAIN_PLUS_k) = BASE_GAIN_k * EXP(+DELTA*U_k/2)
Μ(GAIN_MINUS_k) = BASE_GAIN_k * EXP(-DELTA*U_k/2)
Μ(STATE_36D) = INTERLEAVE[(CHANNEL_PLUS_k, CHANNEL_MINUS_k), k=0..17]
Μ(J_S) = 1 - CONJUGATE(S)
Μ(J_PNV) = SWAP_PAIRS(CONJUGATE(STATE_36D))
Μ(COVARIANCE) = STATE_36D(J_S) == J_PNV(STATE_36D(S))
Μ(DETECTOR_18) = HALF + HALF*S*(S-1)*SUM[k=0..17](CHANNEL_PLUS_k + CHANNEL_MINUS_k)
Μ(DETECTOR_INFINITY) = LIMIT[PAIR_COUNT->INFINITY,U_MAX->INFINITY](DETECTOR_18)
Μ(DETECTOR_INFINITY) = XI(S)
Μ(CLOSURE_DEFECT) = SUM[k=0..17](LOG(GAIN_PLUS_k/GAIN_MINUS_k)^2) / SUM[k=0..17](U_k^2)
Μ(CLOSURE_IDENTITY) = CLOSURE_DEFECT == (RE(S)-HALF)^2
Μ(NATIVE_CLOSED) = (CLOSURE_DEFECT == 0)
Μ(HALF_AXIS_EQUIVALENCE) = NATIVE_CLOSED <=> RE(S)==HALF

─── SOH / CONDITIONAL THEOREM AND OPEN BRIDGE ───
# Exact implication inside the construction:
Μ(CONDITIONAL_HALF_AXIS) = ZERO(DETECTOR_INFINITY) AND NATIVE_CLOSED => RE(S)==HALF

# This is the only unproved promotion required for RH:
Μ(OPEN_BRIDGE_SOH_PN_C001) = NONTRIVIAL_ZERO(XI(S)) => NATIVE_CLOSED

# Therefore:
Μ(RH_CONDITIONAL) = OPEN_BRIDGE_SOH_PN_C001 AND CONDITIONAL_HALF_AXIS => ALL_NONTRIVIAL_ZEROS_ON_HALF_AXIS
