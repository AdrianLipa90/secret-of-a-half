─── SOH / NATIVE MEANING EQUATIONS ───
Μ(CENTERED_Z) = S - 1/2
Μ(SPECTRAL_R) = CENTERED_Z / I
Μ(J_R) = CONJUGATE(SPECTRAL_R)
Μ(HALF_SEPARATION) = PI / TARGET_ORDINATE
Μ(PSI_C(R)) = EXP(I*C*(R-TARGET_ORDINATE) - GAUSSIAN_WIDTH^2*(R-TARGET_ORDINATE)^2/2)
Μ(H_IJ(R)) = CONJUGATE(PSI_I(CONJUGATE(R))) * PSI_J(R)
Μ(HHAT_IJ(X)) = INTEGRAL[R=-INFINITY..INFINITY](H_IJ(R)*EXP(-2*PI*I*X*R) dR)
Μ(HHAT_CLOSED_IJ(X)) = SQRT(PI)/GAUSSIAN_WIDTH * EXP(-2*PI*I*X*TARGET_ORDINATE) * EXP(-((C_J-C_I)-2*PI*X)^2/(4*GAUSSIAN_WIDTH^2))
Μ(POLE_IJ) = H_IJ(+1/(2*I)) + H_IJ(-1/(2*I))
Μ(CONDUCTOR_IJ) = -LOG(PI)/(2*PI) * HHAT_IJ(0)
Μ(ARCHIMEDEAN_IJ) = 1/(2*PI) * INTEGRAL[R=-INFINITY..INFINITY](H_IJ(R)*RE(DIGAMMA(1/4+I*R/2)) dR)
Μ(PRIME_IJ) = -1/(2*PI) * SUM[N>=2](VON_MANGOLDT(N)/SQRT(N) * (HHAT_IJ(LOG(N)/(2*PI)) + HHAT_IJ(-LOG(N)/(2*PI))))
Μ(ARITHMETIC_WEIL_IJ) = POLE_IJ + CONDUCTOR_IJ + ARCHIMEDEAN_IJ + PRIME_IJ
Μ(ARITHMETIC_MATRIX) = HERMITIAN_MATRIX[ARITHMETIC_WEIL_IJ, I,J IN {-HALF_SEPARATION,+HALF_SEPARATION}]
Μ(CUTOFF_STABLE) = MAX_ENTRY_NORM(MATRIX(AUDIT_PRIME_CUTOFF)-MATRIX(PRIME_CUTOFF)) <= STABILITY_TOLERANCE
Μ(PSD_SAMPLE) = MIN_EIGENVALUE(ARITHMETIC_MATRIX) >= -PSD_TOLERANCE

─── SOH / CLAIM BOUNDARY ───
Μ(EXACT_TRANSFORM_STATEMENT) = HHAT_IJ == HHAT_CLOSED_IJ
