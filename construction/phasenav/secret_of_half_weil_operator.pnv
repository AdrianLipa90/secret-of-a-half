Μ(CHANNEL_MINUS_Z) = EXP(-HALF_SEPARATION*(CENTERED_Z-I*TARGET_ORDINATE) + GAUSSIAN_WIDTH^2*(CENTERED_Z-I*TARGET_ORDINATE)^2/2)
Μ(CHANNEL_PLUS_Z) = EXP(+HALF_SEPARATION*(CENTERED_Z-I*TARGET_ORDINATE) + GAUSSIAN_WIDTH^2*(CENTERED_Z-I*TARGET_ORDINATE)^2/2)
