# Secret of a Half — DHSE-001 Stage B
# Preregistered centre-blind operator-family scan

Μ(PROGRAM) = DHSE_001_STAGE_B
Μ(VERSION) = 0.1
Μ(STATUS) = EXPERIMENTAL_BRANCH_ONLY
Μ(BASE_SEED) = secret-of-a-half:DHSE-001
Μ(STATE_SPACE) = POSITIVE_RATIONAL_PROJECTIVE_ODDS
Μ(IEEE_NAN) = EXCLUDED_FROM_STATE_SPACE

Μ(ENSEMBLE_SIZE) = 64
Μ(STEPS) = 384
Μ(BURN_IN) = 64
Μ(PROJECTIVE_RESIDUAL) = ABS(z-q)/(z+q)
Μ(RADIUS) = 1/10
Μ(CENTRES) = [1/16,1/8,1/4,1/2,1,2,4,8,16]
Μ(TARGET) = q=1_EQUIVALENT_p=1/2

Μ(FAMILY_RECIPROCAL_CALIBRATION_L) = [1,0,1,1]
Μ(FAMILY_RECIPROCAL_CALIBRATION_R) = [1,1,0,1]
Μ(FAMILY_AFFINE_SKEW_L) = [2,1,0,3]
Μ(FAMILY_AFFINE_SKEW_R) = [3,2,0,2]
Μ(FAMILY_MOBIUS_SKEW_L) = [1,1,2,3]
Μ(FAMILY_MOBIUS_SKEW_R) = [3,1,1,2]
Μ(FAMILY_SCALE_TRANSLATE_L) = [2,0,0,1]
Μ(FAMILY_SCALE_TRANSLATE_R) = [1,3,0,1]
Μ(FAMILY_COLLATZ_STREAM_L) = [1,0,0,2]
Μ(FAMILY_COLLATZ_STREAM_R) = [3,1,0,2]

Μ(FAMILY_PASS) = TARGET_STRICT_FIRST_AND_RATIO_GE_5/4
Μ(ZERO_CONTROL_MEDIAN) = POSITIVE_TARGET_MEANS_INFINITE_RATIO
Μ(ROBUST_PASS) = AT_LEAST_3_OF_4_EXPERIMENTAL_FAMILIES
Μ(NO_PROMOTION) = DOES_NOT_ORDER_NAN_ZERO_OR_PROVE_RH
