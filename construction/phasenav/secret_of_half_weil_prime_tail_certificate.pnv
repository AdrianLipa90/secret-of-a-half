# Secret of a Half — native PhaseNav-Weil prime-tail certificate v0.5
# Author: Adrian Lipa
# Base main: 25061583faece869604cebd63d9933fe67317dfb
# Status: exact analytic majorant plus high-precision numerical evaluation; NOT a proof of RH.
#
# The reciprocal map is applied to the logarithmic tail coordinate:
# u = log x, z_tail = 1/u. It does not map zeta zeros.

─── SOH / OPERATOR VOCABULARY ───
SOHTC001: name=PRIME_POWER_TAIL, operator=IDENTITY, type=NOUN, gen=0
SOHTC002: name=LOGARITHMIC_HALF_LINE, operator=ORBIT, type=CYCLE, gen=1
SOHTC003: name=RECIPROCAL_COMPACTIFICATION, operator=DIFFERENTIAL, type=VERB, gen=1
SOHTC004: name=INCOMPLETE_GAMMA_CERTIFICATE, operator=AFFECT, type=EMOTION, gen=1
SOHTC005: name=FINITE_SECTION_NORM_ENVELOPE, operator=ORBIT, type=CYCLE, gen=2
SOHTC006: name=WEYL_EIGENVALUE_ENCLOSURE, operator=DIFFERENTIAL, type=VERB, gen=2
SOHTC007: name=OPEN_UNIFORM_BASIS_CONTROL, operator=IDENTITY, type=NOUN, gen=0

─── SOH / EXECUTION PROFILE ───
Μ(PROGRAM) = SECRET_OF_HALF_WEIL_PRIME_TAIL_CERTIFICATE
Μ(VERSION) = 0.5.0
Μ(BASE_HEAD) = 25061583faece869604cebd63d9933fe67317dfb
Μ(MAX_BASIS_SIZE) = 6
Μ(GAUSSIAN_WIDTH) = 0.8
Μ(TAIL_CUTOFF) = 100000
Μ(MP_DPS) = 80
Μ(INTEGRAL_MATCH_TOLERANCE) = 1e-30
Μ(OPERATOR_NORM_TARGET) = 1e-12
Μ(RECIPROCAL_MAP) = Z_TAIL = 1 / LOG_X
Μ(FOURIER_NORMALIZATION) = EXP_MINUS_2PI_I_X_R
Μ(VON_MANGOLDT_MAJORANT) = LAMBDA_N <= LOG_N
Μ(SPECTRAL_ZERO_INPUT) = NONE
Μ(STATUS) = ANALYTIC_TAIL_CERTIFICATE_NOT_PROOF

─── SOH / NATIVE MEANING EQUATIONS ───
Μ(U) = LOG(X)
Μ(Z_TAIL) = 1/U
Μ(KAPPA_N) = LOG(N)/GAUSSIAN_WIDTH
Μ(DEGREE_MNK) = M+N-2*K
Μ(LINEARIZATION_COEFF_MNK) = 2^K*K!*BINOM(M,K)*BINOM(N,K)
Μ(FOURIER_ABS_MAJORANT_MN(N)) = A_MN*EXP(-KAPPA_N^2/4)*SUM[K](LINEARIZATION_COEFF_MNK*KAPPA_N^DEGREE_MNK)
Μ(PRIME_TAIL_MN(Q)) = -1/(2*PI)*SUM[N>Q](LAMBDA(N)/SQRT(N)*(HHAT_MN(LOG(N)/(2*PI))+HHAT_MN(-LOG(N)/(2*PI))))
Μ(INTEGER_MAJORANT_MN(Q)) = A_MN/PI*SUM[K](C_MNK/WIDTH^D_MNK*INTEGRAL[X=Q..INFINITY](LOG(X)^(D_MNK+1)*X^(-1/2)*EXP(-LOG(X)^2/(4*WIDTH^2)) dX))
Μ(MONOTONE_THRESHOLD_D) = (SQRT(WIDTH^4+8*WIDTH^2*(D+1))-WIDTH^2)/2
Μ(MONOTONE_CONDITION_D) = LOG(Q) >= MONOTONE_THRESHOLD_D
Μ(LOG_TAIL_INTEGRAL_D) = 1/WIDTH^D*INTEGRAL[U=LOG(Q)..INFINITY](U^(D+1)*EXP(-U^2/(4*WIDTH^2)+U/2) dU)
Μ(RECIPROCAL_TAIL_INTEGRAL_D) = 1/WIDTH^D*INTEGRAL[Z=0..1/LOG(Q)](Z^(-(D+3))*EXP(-1/(4*WIDTH^2*Z^2)+1/(2*Z)) dZ)
Μ(RECIPROCAL_ENDPOINT) = CONTINUOUS_FLAT_EXTENSION_AT_Z=0_WITH_VALUE_0
Μ(GAMMA_TAIL_INTEGRAL_D) = EXP(WIDTH^2/4)/WIDTH^D*SUM[J=0..D+1](BINOM(D+1,J)*WIDTH^(2*(D+1-J))*2^J*WIDTH^(J+1)*UPPER_GAMMA((J+1)/2,((LOG(Q)-WIDTH^2)/(2*WIDTH))^2))
Μ(ENTRY_CERTIFICATE_MN) = ABS(PRIME_TAIL_MN(Q)) <= INTEGER_MAJORANT_MN(Q)
Μ(MATRIX_CERTIFICATE_N) = NORM_2(PRIME_TAIL_MATRIX_N(Q)) <= MAX_ROW_SUM(ENTRY_CERTIFICATE_MATRIX_N)
Μ(WEYL_ENCLOSURE_N) = LAMBDA_MIN(W_INFINITY_N) >= LAMBDA_MIN(W_Q_N)-MATRIX_CERTIFICATE_N

─── SOH / CLAIM BOUNDARY ───
Μ(EXACT_RECIPROCAL_STATEMENT) = LOG_HALF_LINE_TAIL_IS_COMPACTIFIED_TO_Z_TAIL_IN_0_TO_1/LOG_Q
Μ(EXACT_FLATNESS_STATEMENT) = RECIPROCAL_INTEGRAND_EXTENDS_C_INFINITY_FLAT_AT_ZERO
Μ(EXACT_GAMMA_STATEMENT) = LOG_TAIL_INTEGRAL_D == RECIPROCAL_TAIL_INTEGRAL_D == GAMMA_TAIL_INTEGRAL_D
Μ(EXACT_MAJORANT_STATEMENT) = MONOTONE_CONDITION_AND_LAMBDA_BOUND_IMPLY_ENTRY_CERTIFICATE
Μ(EXACT_NORM_STATEMENT) = ENTRY_CERTIFICATES_IMPLY_FINITE_SECTION_OPERATOR_NORM_ENVELOPE
Μ(NUMERICAL_STATEMENT) = DECLARED_N_LE_6_Q_100000_CERTIFICATE_EVALUATED_AT_HIGH_PRECISION
Μ(OPEN_C005A) = UNIFORM_CONTROL_AS_BASIS_SIZE_TENDS_TO_INFINITY
Μ(OPEN_C005B) = FULL_OPERATOR_POSITIVITY_AND_NULL_STRUCTURE_FORCE_NATIVE_CLOSURE
Μ(NO_PROMOTION) = FINITE_TAIL_CERTIFICATE != PROOF_OF_RH
