─── SOH / PRIMITIVE COORDINATES ───
Μ(SIGMA_STAR) = 1/2
Μ(CENTERED_SIGMA) = SIGMA - SIGMA_STAR
Μ(COMPLEMENT) = 1 - SIGMA
Μ(COMPLEMENT_CENTERED) = -CENTERED_SIGMA
Μ(Q) = NORMALIZED_TURN IN R/Z
Μ(FREQUENCY_Q) = DELTA_WINDING / DELTA_TIME
Μ(PHASE_REPRESENTATION) = PHI = CLOSURE_PERIOD * Q
Μ(RADIAN_REPRESENTATION) = CLOSURE_PERIOD = TAU
Μ(SPINOR_SHEET) = (-1)^PROJECTIVE_WINDING

─── SOH / GEOMETRIC NUMBER SEMANTICS ───
Μ(NEGATIVE) = ORIENTATION(CENTERED_OR_TANGENT_DISPLACEMENT) < 0
Μ(ZERO) = CENTERED_OR_TANGENT_DISPLACEMENT == 0
Μ(POSITIVE) = ORIENTATION(CENTERED_OR_TANGENT_DISPLACEMENT) > 0
# This is a computational geometry convention, not a proof of the physical origin of R.

