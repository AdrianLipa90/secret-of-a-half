# Secret of a Half — DHSE-001 deterministic seed dynamics
# Experimental branch only. No promotion to main or monograph.

Μ(PROGRAM) = SECRET_OF_HALF_DHSE_001
Μ(VERSION) = 0.1.0
Μ(STAGE) = A_CALIBRATION
Μ(SEED) = secret-of-a-half:DHSE-001
Μ(STEPS) = 256
Μ(STATE_SPACE) = POSITIVE_RATIONAL_PROJECTIVE_ODDS
Μ(DEFINED_ZERO_VERTEX) = P_EQUALS_0
Μ(UNDEFINED_BOTTOM_VERTEX) = P_EQUALS_1
